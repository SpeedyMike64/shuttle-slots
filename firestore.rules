rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player: name, color, created time, a 238-character grid of marks,
    // and an optional mode ('free' means the marks are times they can play)
    function validPlayer(id) {
      return id.size() <= 20
        && request.resource.data.keys().hasOnly(['name', 'color', 'created', 'busy', 'mode'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.color is int
        && request.resource.data.color >= 0
        && request.resource.data.color < 12
        && request.resource.data.created is int
        && request.resource.data.busy is string
        && request.resource.data.busy.size() == 238
        && request.resource.data.busy.matches('^[01]+$')
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['busy', 'free']);
    }
    // The original badminton group
    match /people/{id} {
      allow read: if true;
      allow delete: if id.size() <= 20;
      allow create, update: if validPlayer(id);
    }
    // Every other friend group: /groups/<group name>/people/<player>
    match /groups/{group}/people/{id} {
      allow read: if group.size() <= 30;
      allow delete: if group.size() <= 30 && id.size() <= 20;
      allow create, update: if group.size() <= 30 && validPlayer(id);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
