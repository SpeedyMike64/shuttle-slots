rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A player: name, color and when they joined. Older entries also carry a busy/mode grid, now unused.
    function validPlayer(id) {
      let d = request.resource.data;
      return id.size() <= 20
        && d.keys().hasOnly(['name', 'color', 'created', 'busy', 'mode'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.color is int && d.color >= 0 && d.color < 12
        && d.created is int
        && (!('busy' in d) || (d.busy is string && d.busy.size() == 238 && d.busy.matches('^[01]+$')))
        && (!('mode' in d) || d.mode in ['busy', 'free']);
    }
    // One player's free half hours for one week (named by its Monday): 238 characters of 0/1
    function validMarks(week, id) {
      let d = request.resource.data;
      return week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && id.size() <= 20
        && d.keys().hasOnly(['free'])
        && d.free is string && d.free.size() == 238 && d.free.matches('^[01]+$');
    }
    // The original badminton group
    match /people/{id} {
      allow read: if true;
      allow delete: if id.size() <= 20;
      allow create, update: if validPlayer(id);
    }
    match /weeks/{week}/marks/{id} {
      allow read: if true;
      allow delete: if id.size() <= 20;
      allow create, update: if validMarks(week, id);
    }
    // Every other friend group: /groups/<group name>/...
    match /groups/{group}/people/{id} {
      allow read: if group.size() <= 30;
      allow delete: if group.size() <= 30 && id.size() <= 20;
      allow create, update: if group.size() <= 30 && validPlayer(id);
    }
    match /groups/{group}/weeks/{week}/marks/{id} {
      allow read: if group.size() <= 30;
      allow delete: if group.size() <= 30 && id.size() <= 20;
      allow create, update: if group.size() <= 30 && validMarks(week, id);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
